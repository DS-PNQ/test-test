<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Audio recording for ASR -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Foreground service for continuous translation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Wake lock to keep processing during translation -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Android 11+ package visibility: without these declarations the app
      cannot RESOLVE installed TTS engine services or the system voice-data
      installer — even when Google TTS is installed — which made Chinese
      system TTS report "no engine installed / engine not ready". Queried
      by TTSModule (chooseEnginePackage / isAnyTtsEngineInstalled).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_INSTALL_DATA" />
        </intent>
        <package android:name="com.google.android.tts" />
        <package android:name="com.samsung.SMT" />
        <package android:name="com.iflytek.tts" />
        <package android:name="com.svox.pico" />
    </queries>

    <application
        android:name=".OmniVoiceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniVoice"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- Splash / Model Loading -->
        <activity
            android:name=".LoadingActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.OmniVoice.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Translation UI -->
        <activity
            android:name=".TranslationActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenLayout|screenSize"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.OmniVoice" />

    </application>

</manifest>
