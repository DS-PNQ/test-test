<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Audio recording for ASR -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Foreground service for continuous translation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Wake lock to keep processing during translation -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".OmniVoiceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniVoice"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- Splash / Model Loading -->
        <activity
            android:name=".LoadingActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.OmniVoice.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Translation UI -->
        <activity
            android:name=".TranslationActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenLayout|screenSize"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.OmniVoice" />

    </application>

</manifest>
